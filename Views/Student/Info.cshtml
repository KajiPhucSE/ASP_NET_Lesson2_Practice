@* Khai báo kiểu dữ liệu cho Model (ở bài này Model là một chuỗi văn bản - string) *@
@model string

@{
   
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Thông tin sinh viên</title>
</head>
<body>
    <h2>Thông tin chi tiết:</h2>

    <p><strong>Tên:</strong> @ViewBag.Name</p>

    <p><strong>Tuổi:</strong> @ViewData["Age"]</p>

    <p><strong>Ngành:</strong> @Model</p>
</body>
</html>
